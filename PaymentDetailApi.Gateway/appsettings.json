{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "your-super-secret-key-must-be-at-least-32-chars!!",
    "Issuer": "PaymentDetailApi",
    "Audience": "PaymentDetailApiClient"
  },
  "ReverseProxy": {
    "Routes": {
      "registerRoute": {
        "ClusterId": "paymentDetailApiCluster",
        "Match": {
          "Path": "/api/v1/register",
          "Methods": [ "POST" ]
        }
      },
      "loginRoute": {
        "ClusterId": "paymentDetailApiCluster",
        "Match": {
          "Path": "/api/v1/login",
          "Methods": [ "POST" ]
        }
      },
      "paymentDetailsRoute": {
        "ClusterId": "paymentDetailApiCluster",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "sliding",
        "Match": {
          "Path": "/api/v1/payment-details/{**catch-all}"
        }
      },
      "paymentDetailApiRoute": {
        "ClusterId": "paymentDetailApiCluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "paymentDetailApiCluster": {
        "Destinations": {
          "paymentDetailApiDestination": {
            "Address": "https://localhost:7128"
          }
        }
      }
    }
  }
}
