{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "your-super-secret-key-must-be-at-least-32-chars!!",
    "Issuer": "PaymentDetailApi",
    "Audience": "PaymentDetailApiClient"
  },
  "ReverseProxy": {
    "Routes": {
      "registerRoute": {
        "ClusterId": "paymentDetailApiCluster",
        "Match": {
          "Path": "/api/v1/register",
          "Methods": [ "POST" ]
        }
      },
      "loginRoute": {
        "ClusterId": "paymentDetailApiCluster",
        "Match": {
          "Path": "/api/v1/login",
          "Methods": [ "POST" ]
        }
      },
      "paymentDetailsRoute": {
        "ClusterId": "paymentDetailApiCluster",
        "AuthorizationPolicy": "Authenticated",
        "RateLimiterPolicy": "sliding",
        "Match": {
          "Path": "/api/v1/payment-details/{**catch-all}"
        }
      },
      "paymentDetailApiRoute": {
        "ClusterId": "paymentDetailApiCluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "paymentDetailApiCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10", //check health every 10 seconds
            "Timeout": "00:00:05", //wait for 5 seconds for a response
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        },
        "Destinations": {
          "paymentDetailApiDestination1": {
            "Address": "https://localhost:7128"
          },
          "paymentDetailApiDestination2": {
            "Address": "https://localhost:7129"
          },
          "paymentDetailApiDestination3": {
            "Address": "https://localhost:7130"
          }
        }
      }
    }
  }
}
